# ---------------------------------------------------------------------------
# N-ATLAS LocalizeKit backend configuration
#
# Copy to `.env` for local development (gitignored). On Vercel, set the same
# variables in Project Settings → Environment Variables. They are read only on
# the server — never prefix them with VITE_ and never commit real values.
# ---------------------------------------------------------------------------

# Always "http": an OpenAI-compatible endpoint serving NCAIR1/N-ATLaS.
NATLAS_PROVIDER=http

# Base URL of the N-ATLAS endpoint (the client appends /chat/completions).
#   Hosted GPU (inference/modal_natlas.py): https://<workspace>--localizekit-natlas-serve.modal.run/v1
#   Local Ollama (CPU, slow):               http://localhost:11434/v1
NATLAS_ENDPOINT=

# Bearer key for the endpoint. For the Modal deployment this is the value stored
# in the Modal secret "localizekit-natlas". Leave blank for local Ollama.
NATLAS_API_KEY=

# Model name the server expects.
#   Modal/vLLM: NCAIR1/N-ATLaS     Ollama: the tag you created, e.g. n-atlas
NATLAS_MODEL=NCAIR1/N-ATLaS

# Request timeout in ms. Vercel functions stop at 300s, so stay below that.
NATLAS_REQUEST_TIMEOUT_MS=280000

# Max N-ATLAS calls per client per window (each call uses GPU time).
RATE_LIMIT_PER_WINDOW=40
RATE_LIMIT_WINDOW_MS=600000

# Local server port.
PORT=8788
