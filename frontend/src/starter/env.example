# Copy to .env and fill in. Never commit .env or put these values in browser code.

# Your OpenAI-compatible N-ATLAS endpoint (see inference/modal_natlas.py to host one).
NATLAS_ENDPOINT=https://<your-workspace>--localizekit-natlas-serve.modal.run/v1
NATLAS_API_KEY=
NATLAS_MODEL=NCAIR1/N-ATLaS
# A sleeping GPU takes ~2–3 minutes to start; keep this above that.
NATLAS_TIMEOUT_MS=300000

# Websites allowed to use the chat widget, comma-separated (exact origins).
# Example: https://www.example.com,https://example.com
ALLOWED_ORIGINS=

PORT=3000
RATE_LIMIT_PER_MINUTE=20
